PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/securelend?retryWrites=true&w=majority
# Optional: use a standard mongodb:// URI if your network blocks SRV DNS lookups.
MONGODB_URI_FALLBACK=
# Optional: DNS resolvers used to derive non-SRV Atlas hosts when SRV lookup fails locally.
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
JWT_SECRET=replace_me
JWT_EXPIRES_IN=7d
ML_SERVICE_URL=https://your-ml-service.onrender.com
CORS_ORIGINS=https://your-frontend.vercel.app

# Blockchain (Hedera)
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=0.0.<account-id>
HEDERA_PRIVATE_KEY=<hedera-private-key>
HEDERA_CONTRACT_ID=0.0.<contract-id>

# Email OTP — option A (recommended for Render free tier, which BLOCKS SMTP ports 25/465/587):
# Brevo HTTPS email API (free 300 emails/day). Sign up at https://www.brevo.com →
# SMTP & API → API Keys. EMAIL_FROM must be a sender you verified in Brevo (a Gmail address works).
BREVO_API_KEY=
EMAIL_FROM=your-email@gmail.com

# Email OTP — option B (works locally / on paid hosts): Gmail SMTP with an App Password, NOT your login password
# How to get: Google Account → Security → 2-Step Verification → App Passwords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# SMS OTP (Fast2SMS — free credits for Indian numbers)
# Sign up at https://www.fast2sms.com → Dashboard → Dev API → API Key
FAST2SMS_API_KEY=<your-fast2sms-api-key>
# 'q' = Quick SMS route (needs a one-time wallet recharge on Fast2SMS)
# 'otp' = OTP route (needs Fast2SMS website verification). If SMS fails, signup continues with email OTP only.
FAST2SMS_ROUTE=q

# How long to wait for the ML service (ms) and whether to ping it every 10 min to keep it awake
ML_SERVICE_TIMEOUT_MS=10000
ML_KEEP_WARM=true

# Optional: enables POST /admin/setup (send header x-admin-setup-secret)
ADMIN_SETUP_SECRET=

# Admin seed configuration
ADMIN_NAME=<admin-name>
ADMIN_EMAIL=admin@securelend.com
ADMIN_PASSWORD=Admin@1234
ADMIN_PHONE=<admin-phone>
